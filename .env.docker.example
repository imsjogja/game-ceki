# Copy the values you want to override into `.env` before running Docker Compose.
# `.env` is ignored by Git. The defaults in compose.yaml are for local use only.

APP_PORT=3000
MYSQL_PORT=3306
APP_ORIGIN=http://localhost:3000

MYSQL_DATABASE=remiku
MYSQL_USER=remiku
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password

APP_SECRET=change-me-with-a-long-random-secret

# Optional: required only when using "Masuk dengan Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GOOGLE_SUB=
