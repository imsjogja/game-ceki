# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=change-me-with-a-long-random-secret
APP_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/remiku

# ── Google OAuth (optional for guest-only local development) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin Role ──────────────────────────────────────────────────
OWNER_GOOGLE_SUB=

# ── Voice chat / WebRTC ─────────────────────────────────────────
# TURN diperlukan agar voice bisa terhubung pada jaringan NAT/firewall ketat.
VOICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
VOICE_TURN_TTL_SECONDS=600
